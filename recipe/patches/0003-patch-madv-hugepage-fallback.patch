From 9390455644096a1eaa5047d47f29c71dd2cdf81c Mon Sep 17 00:00:00 2001
From: Mike Hance <mhance@gmail.com>
Date: Tue, 3 Nov 2026 14:00:27 -0800
Subject: [PATCH] define MADV_HUGEPAGE fallback for non-Linux (osx)

---
 src/libSpec/app/specBenchmarkDma.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/libSpec/app/specBenchmarkDma.cpp b/src/libSpec/app/specBenchmarkDma.cpp
index fe52890..4cd32a7 100644
--- a/src/libSpec/app/specBenchmarkDma.cpp
+++ b/src/libSpec/app/specBenchmarkDma.cpp
@@ -15,6 +15,11 @@
 #include <string>
 #include <vector>
 #include <sys/mman.h>
+#ifndef MADV_HUGEPAGE
+// MADV_HUGEPAGE is Linux-specific (transparent hugepages); fall back to
+// MADV_NORMAL (0) on platforms that lack it, e.g. macOS.
+#define MADV_HUGEPAGE 0
+#endif
 #include <sys/time.h>
 
 namespace {
